{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**remainder}"
        },
        "RateLimiterPolicy": "auth",
        "Order": 1
      },
      "forum": {
        "ClusterId": "forum",
        "Match": {
          "Path": "/api/forum/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "finance": {
        "ClusterId": "finance",
        "Match": {
          "Path": "/api/finance/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/notifications/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "household": {
        "ClusterId": "household",
        "Match": {
          "Path": "/api/households/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "math": {
        "ClusterId": "math",
        "Match": {
          "Path": "/api/math/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "geography": {
        "ClusterId": "geography",
        "Match": {
          "Path": "/api/geography/{**remainder}"
        },
        "RateLimiterPolicy": "api",
        "Order": 1
      },
      "frontend": {
        "ClusterId": "frontend",
        "Order": 100,
        "Match": {
          "Path": "/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "forum": {
        "Destinations": {
          "primary": {
            "Address": "http://forum:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "finance": {
        "Destinations": {
          "primary": {
            "Address": "http://finance:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://notifications:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "household": {
        "Destinations": {
          "primary": {
            "Address": "http://household:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "math": {
        "Destinations": {
          "primary": {
            "Address": "http://math:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "geography": {
        "Destinations": {
          "primary": {
            "Address": "http://geography:8080"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "primary": {
            "Address": "http://frontend:3000"
          }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "CanonicalHost": "",
  "Acme": {
    "WebRoot": ""
  },
  "Uploads": {
    "Avatars": "",
    "Forum": ""
  }
}
