{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**remainder}" }
      },
      "forum": {
        "ClusterId": "forum",
        "Match": { "Path": "/api/forum/{**remainder}" }
      },
      "finance": {
        "ClusterId": "finance",
        "Match": { "Path": "/api/finance/{**remainder}" }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/notifications/{**remainder}" }
      },
      "household": {
        "ClusterId": "household",
        "Match": { "Path": "/api/households/{**remainder}" }
      },
      "math": {
        "ClusterId": "math",
        "Match": { "Path": "/api/math/{**remainder}" }
      },
      "geography": {
        "ClusterId": "geography",
        "Match": { "Path": "/api/geography/{**remainder}" }
      }
    },

    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "forum": {
        "Destinations": { "primary": { "Address": "http://forum:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "finance": {
        "Destinations": { "primary": { "Address": "http://finance:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "notifications": {
        "Destinations": { "primary": { "Address": "http://notifications:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "household": {
        "Destinations": { "primary": { "Address": "http://household:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "math": {
        "Destinations": { "primary": { "Address": "http://math:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      },
      "geography": {
        "Destinations": { "primary": { "Address": "http://geography:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate" } }
      }
    }
  }
}
